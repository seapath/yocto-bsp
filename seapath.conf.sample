# SEAPATH configuration file sample
# This file can be used as example to create a seapath.conf file.
# Each variable defined here is set as it default value.

# Keymap
SEAPATH_KEYMAP='us'

# Limite the number of jobs to compile Ceph to avoid out of memory errors
SEAPATH_PARALLEL_MAKE='8'

# CPUs reserved for real time applications, containers and VMs.
# It can be an single CPU or a plage delimited by - (e.g. 2-5). Mulitples CPUs
# and plages can be defined using , as seperator (e.g 0,2-5,7,10-12).
# The CPU enumeration begins at 0, so the maximum value is 1 less than the
# number of CPUs core on the system.
# If not defined, no CPU will be reserved.
SEAPATH_RT_CORES='2-N'

# Hashed password to access Grub shell if security is enabled.
# The password has to be stored hashed in pbkdf2 format.
# To generate the hashed from the plain password, the following command can be
# used:
# grub-mkpasswd-pbkdf2 -c 65536 -s 256 -l 64
SEAPATH_GRUB_PASSWORD=''

# Time in seconds grub waiting before boot SEAPATH.
SEAPATH_GRUB_TIMEOUT='0'

# Set to true to disable IPv6.
SEAPATH_DISABLE_IPV6='false'

# Set to true to disable IPv6 for guest images
SEAPATH_GUEST_DISABLE_IPV6='false'

# Set to 1 to skip the compilation option report. Reduce the generation time by
# more than one hour. Set anything else to generate the report.
SEAPATH_SECCOMPILE_MANIFEST_SKIP='1'

# Disk to autoflash with the flasher image. If not set or empty the autoflash
# will be disabled. Ex : /dev/sda
SEAPATH_AUTO_FLASH=""

# Set to true to enable the Cockpit web UI interface. Disabled by default.
SEAPATH_COCKPIT='false'

# Set to true to install LTTng tracing tool. Disabled by default.
SEAPATH_USE_LTTNG='false'

# Set to true to enable a LTTng trace point in cyclictest.
# The tracepoint is triggered when a latency is over the threshold defined
# by the --spike option of cyclictest. Disabled by default.
SEAPATH_CYCLICTEST_TP='false'

# Set to true to remove recipe work directories after build and save disk
# space. Enabled by default.
SEAPATH_RM_WORK='true'

# SWUpdate CMS signing key material. Used to sign the sw-description of the
# host, host-test and observer update packages, and to install the trust
# anchors in their rootfs. Leave empty to use the default keys/swupdate-keys/
# layout (see keys/README.adoc). A throwaway PKI can be generated with:
#   scripts/generate-swupdate-keys.sh -o keys/swupdate-keys
#
# Directory holding the key material (ca/, signer.crt, signer.key).
# Use an absolute path: the build has no well-defined working directory for
# relative paths.
SEAPATH_SWUPDATE_KEYS_DIR=''
# Signing certificate (leaf, EKU=codeSigning) and its unencrypted private key.
SEAPATH_SWUPDATE_CMS_CERT=''
SEAPATH_SWUPDATE_CMS_KEY=''
# Extra certificates embedded in the CMS signature (the intermediate CA).
SEAPATH_SWUPDATE_CMS_EXTRA_CERTS=''
# Directory of trusted CA certificates assembled into the rootfs trust store.
SEAPATH_SWUPDATE_CA_CERTS_DIR=''
